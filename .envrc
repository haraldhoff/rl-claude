# The venv cannot live in the repo: /mnt/c is a 9p drvfs mount owned by root with
# no metadata support, so uv's metadata-preserving copy fails partway through
# `uv sync` and leaves empty namespace stubs behind. Keep it on ext4 instead.
export UV_PROJECT_ENVIRONMENT="$HOME/.venvs/rl-claude"

# This project ships no console scripts -- train.py and play.py stay repo
# scripts -- so this is what makes `python train.py`, `pytest tests` and
# `ruff check` work without a `uv run` prefix.
PATH_add "$HOME/.venvs/rl-claude/bin"

# JAX's default preallocator asks for ~75% of the card in one block, which WSL2
# refuses however much is free: it walks the request down in a dozen steps,
# printing a CUDA_ERROR_OUT_OF_MEMORY wall each time, before falling back to
# on-demand allocation and training fine anyway. Skip the theatre -- the
# fallback is what ends up running either way.
export XLA_PYTHON_CLIENT_PREALLOCATE=false
